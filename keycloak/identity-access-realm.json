{
  "realm": "identity-access",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "clients": [
    {
      "clientId": "identity-access-app",
      "name": "Identity Access Lab local demo",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8000/auth/callback"],
      "webOrigins": ["http://localhost:8000"],
      "protocolMappers": [
        {
          "name": "lab_role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lab_role",
            "claim.name": "lab_role",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ingeniero@example.test",
      "email": "ingeniero@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "LAB",
      "lastName": "INGENIERO",
      "attributes": {"lab_role": ["mantenimiento"]},
      "credentials": [{"type": "password", "value": "${DEMO_PASSWORD_ENGINEER}", "temporary": false}]
    },
    {
      "username": "auditor@example.test",
      "email": "auditor@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "LAB",
      "lastName": "AUDITOR",
      "attributes": {"lab_role": ["auditor"]},
      "credentials": [{"type": "password", "value": "${DEMO_PASSWORD_AUDITOR}", "temporary": false}]
    },
    {
      "username": "admin@example.test",
      "email": "admin@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "LAB",
      "lastName": "ADMIN",
      "attributes": {"lab_role": ["admin"]},
      "credentials": [{"type": "password", "value": "${DEMO_PASSWORD_ADMIN}", "temporary": false}]
    }
  ]
}
